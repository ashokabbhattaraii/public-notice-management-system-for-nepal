# ── API service environment ───────────────────────────
# Copy to .env and fill in real values

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/govnotice

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — from Google Cloud Console (OAuth 2.0 Client ID, type "Web application").
# The web app must use this SAME client id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowlist of emails granted the "admin" role on login.
ADMIN_EMAILS=ashok.ab.bhattaraii@gmail.com

# Allowed browser origin(s) for CORS (comma-separated).
WEB_ORIGIN=http://localhost:3000

# AI service
AI_SERVICE_URL=http://localhost:8000
# Max time to wait for the AI service to index one document (OCR + embedding).
AI_INDEX_TIMEOUT_MS=600000

# Scraping
SCRAPING_CONCURRENCY=3
SCRAPING_INTERVAL_CRON=0 6 * * *
