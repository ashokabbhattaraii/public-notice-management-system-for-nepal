# ── API service environment ───────────────────────────
# Copy to .env and fill in real values

PORT=3001
NODE_ENV=development

# ── Observability ────────────────────────────────────
# Structured JSON logger level: verbose | debug | info | log | warn | error | fatal
LOG_LEVEL=info
# "json" (default) — one JSON object per line, ready for CloudWatch/Loki/Datadog.
# Set to "pretty" for colored human-readable output during local development.
LOG_FORMAT=json
# Log every Prisma query (and slow queries >= DB_SLOW_QUERY_MS) — mostly for dev.
DB_LOG_QUERIES=false
# Queries slower than this (ms) are logged as warnings. 0 disables slow-query logging.
DB_SLOW_QUERY_MS=500

# Database
# Point this at your Postgres instance (dev, staging or prod).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/public_notice_management
# Prisma connection pool size and wait timeout. Tune to your DB's max_connections.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_MS=20000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — from Google Cloud Console (OAuth 2.0 Client ID, type "Web application").
# The web app must use this SAME client id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowlist of emails granted the "admin" role on login.
ADMIN_EMAILS=ashok.ab.bhattaraii@gmail.com

# Allowed browser origin(s) for CORS (comma-separated). The production domains
# (https://suchanaai.tech, https://www.suchanaai.tech) are always allowed in code.
WEB_ORIGIN=http://localhost:3535

# Public site URL used inside WhatsApp alert message links (notice + manage-alerts
# links). Always the real public domain, never WEB_ORIGIN/localhost — WhatsApp
# won't render localhost links as tappable, and a recipient's phone can't reach it.
PUBLIC_SITE_URL=https://suchanaai.tech

# AI service
AI_SERVICE_URL=http://localhost:8000
# Max time to wait for the AI service to index one document (OCR + embedding).
AI_INDEX_TIMEOUT_MS=600000

# ── File storage (S3) ──────────────────────────────────
# Every uploaded RAG document and every cached scraped-notice attachment
# lives in this one private S3 bucket — nothing is ever written to local
# disk (see src/common/storage/s3-storage.service.ts). The bucket blocks all
# public access; files are only ever reached via short-lived presigned URLs
# generated on request (GET /documents/:id/download,
# GET /attachments/:id/file).
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
# Only needed on hosts with no attached AWS IAM role (e.g. a self-hosted
# Oracle/EC2 box running docker-compose). On AWS compute with an instance
# role already scoped to this bucket (Elastic Beanstalk/ECS/EC2), leave both
# unset — the AWS SDK's default credential chain picks up the role
# automatically and these are never read.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp webhook — Evolution API (Evolution instance URL + API key).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=PublicNoticeManagement

# Scraping
# Max concurrent full crawls (cheap sitemap checks are NOT counted against this).
SCRAPING_CONCURRENCY=3
# Automatic polling cron — default: once a minute, at second 0.
SCRAPING_INTERVAL_CRON=0 * * * * *
# A RUNNING scrape older than this (seconds) is considered abandoned and is
# reclaimed as FAILED so the source becomes pollable again.
SCRAPING_STALE_TIMEOUT_SECONDS=3600
# Politeness floor for per-source poll intervals — nothing below this, even
# for sitemap-only checks.
SCRAPING_MIN_POLL_INTERVAL_SECONDS=60

# ── Read-path caching ─────────────────────────────────
# TTL (ms) for the public notices list (page load spikes). 0 disables caching.
NOTICES_LIST_CACHE_MS=10000
# TTL (ms) for meta endpoints (category counts, source dropdowns).
NOTICES_META_CACHE_MS=60000

# ── Membership & billing (Stripe) ─────────────────────
# Secret key for the Stripe REST API (checkout sessions, billing portal, sub lookups).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Signing secret for the /webhooks/stripe endpoint — from the Stripe Dashboard
# (or `stripe listen --print-secret` for local testing).
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Base URL of the web app, used to build Stripe checkout success/cancel and
# billing-portal return URLs. Should match WEB_ORIGIN in production.
APP_URL=http://localhost:3535

# ── AI enrichment guards ──────────────────────────────
# Cooldown (ms) after a failed view-triggered AI call (PDF OCR, summarization)
# before the same notice is retried. Prevents a flaky AI service from being
# pounded by every viewer at once. Concurrent viewers already share one
# in-flight call (single-flight), regardless of this value.
AI_RETRY_COOLDOWN_MS=60000
# TTL (ms) for memoized LLM answers: identical notice Q&A questions and
# identical chatbot search queries share the LLM call within this window.
QA_CACHE_MS=300000
