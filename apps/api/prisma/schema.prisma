// Prisma schema for the public-notice-management API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  inactive
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  // Google account subject id ("sub" claim) — stable, unique per Google account.
  googleId    String     @unique @map("google_id")
  email       String     @unique
  name        String
  avatarUrl   String?    @map("avatar_url")
  role        Role       @default(user)
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  documents   Document[]

  @@map("users")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  UNEMBEDDED
  FAILED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  filename    String
  mimeType    String         @map("mime_type")
  fileSize    Int            @map("file_size")
  filePath    String         @map("file_path")
  status      DocumentStatus @default(PENDING)
  isOcr       Boolean        @default(false) @map("is_ocr")
  isSystem    Boolean        @default(false) @map("is_system")
  textLength  Int?           @map("text_length")
  chunkCount  Int?           @map("chunk_count")
  uploadedBy  String?        @map("uploaded_by") @db.Uuid
  user        User?          @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  indexedAt   DateTime?      @map("indexed_at")

  @@map("documents")
}

enum InternStatus {
  active
  inactive
  completed
}

enum AttendanceStatus {
  present
  absent
  leave
  compensation_leave
}

model Intern {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique
  phone           String?
  department      String?
  startDate       DateTime     @map("start_date")
  endDate         DateTime?    @map("end_date")
  status          InternStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  attendances     Attendance[]
  saturdayRosters SaturdayRoster[]
  compensationLeaves CompensationLeave[]

  @@map("interns")
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  internId  String           @map("intern_id") @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus @default(present)
  remarks   String?
  createdAt DateTime         @default(now()) @map("created_at")

  intern    Intern           @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("attendances")
}

model SaturdayRoster {
  id        String   @id @default(uuid()) @db.Uuid
  internId  String   @map("intern_id") @db.Uuid
  date      DateTime @db.Date
  present   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("saturday_rosters")
}

model CompensationLeave {
  id          String    @id @default(uuid()) @db.Uuid
  internId    String    @map("intern_id") @db.Uuid
  earnedDate  DateTime  @map("earned_date") @db.Date
  usedDate    DateTime? @map("used_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  intern      Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("compensation_leaves")
}

enum ScrapedItemCategory {
  NOTICE
  NEWS
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ScrapePaginationType {
  QUERY_PARAM    // append ?<paginationParam>=<n> (or & if the URL already has a query string)
  PATH_TEMPLATE  // substitute a literal "{page}" token anywhere in the listing URL
  NONE           // single page only, regardless of maxPages
}

// An admin-configured website to scrape for notices/news. CSS extraction
// schemas are auto-detected (heuristics, with an LLM fallback) on first run
// and cached here so subsequent runs are pure, fast CSS parsing.
model ScrapeSource {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  baseUrl           String    @map("base_url")
  // Listing page URLs; at least one of the two must be set.
  noticeListUrl     String?   @map("notice_list_url")
  newsListUrl       String?   @map("news_list_url")
  // Cached JsonCssExtractionStrategy schemas (crawl4ai format), keyed implicitly
  // by category via these two columns. Null until the first successful run.
  noticeSchema      Json?     @map("notice_schema")
  newsSchema        Json?     @map("news_schema")
  // Pagination behavior — sites vary wildly (?page=N, ?start=N, /page/N/, or
  // no pagination at all), so this is admin-configurable per source rather
  // than assumed.
  paginationType    ScrapePaginationType @default(QUERY_PARAM) @map("pagination_type")
  paginationParam   String    @default("page") @map("pagination_param")
  startPage         Int       @default(1) @map("start_page")
  maxPages          Int       @default(3) @map("max_pages")
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastRunAt         DateTime? @map("last_run_at")
  lastStatus        ScrapeRunStatus? @map("last_status")

  items ScrapedItem[]
  runs  ScrapeRun[]

  @@map("scrape_sources")
}

// A single notice or news item scraped from a government portal.
model ScrapedItem {
  id            String              @id @default(uuid()) @db.Uuid
  sourceId      String?             @map("source_id") @db.Uuid
  source        ScrapeSource?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Denormalized label snapshot (source.name at scrape time) so items still
  // render sensibly if a source is later deleted.
  sourceLabel   String              @default("mofa.gov.np") @map("source_label")
  category      ScrapedItemCategory
  title         String
  // Canonical absolute URL of the detail page — used as the dedup key across scrape runs.
  sourceUrl     String              @unique @map("source_url")
  summary       String?
  contentText   String?             @map("content_text")
  contentHtml   String?             @map("content_html")
  attachmentUrl String?             @map("attachment_url")
  publishedAt   DateTime?           @map("published_at")
  // Hash of title+content, used to detect edits to a page we've already scraped.
  contentHash   String              @map("content_hash")
  // Incremented each time the public notice detail page is viewed.
  views         Int                 @default(0)
  scrapedAt     DateTime            @default(now()) @map("scraped_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([category])
  @@index([publishedAt])
  @@index([sourceId])
  @@map("scraped_items")
}

// One execution of a scraping job, for the admin dashboard's logs view.
model ScrapeRun {
  id           String          @id @default(uuid()) @db.Uuid
  sourceId     String?         @map("source_id") @db.Uuid
  source       ScrapeSource?   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceLabel  String          @default("mofa.gov.np") @map("source_label")
  status       ScrapeRunStatus @default(RUNNING)
  itemsFound   Int             @default(0) @map("items_found")
  itemsNew     Int             @default(0) @map("items_new")
  itemsUpdated Int             @default(0) @map("items_updated")
  error        String?
  startedAt    DateTime        @default(now()) @map("started_at")
  finishedAt   DateTime?       @map("finished_at")

  @@index([sourceId])
  @@map("scrape_runs")
}
