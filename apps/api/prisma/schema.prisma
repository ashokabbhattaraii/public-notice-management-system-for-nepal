// Prisma schema for the public-notice-management API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  inactive
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  // Google account subject id ("sub" claim) — stable, unique per Google account.
  googleId    String     @unique @map("google_id")
  email       String     @unique
  name        String
  avatarUrl   String?    @map("avatar_url")
  role        Role       @default(user)
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  documents   Document[]

  @@map("users")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  UNEMBEDDED
  FAILED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  filename    String
  mimeType    String         @map("mime_type")
  fileSize    Int            @map("file_size")
  filePath    String         @map("file_path")
  status      DocumentStatus @default(PENDING)
  isOcr       Boolean        @default(false) @map("is_ocr")
  textLength  Int?           @map("text_length")
  chunkCount  Int?           @map("chunk_count")
  uploadedBy  String         @map("uploaded_by") @db.Uuid
  user        User           @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  indexedAt   DateTime?      @map("indexed_at")

  @@map("documents")
}

enum InternStatus {
  active
  inactive
  completed
}

enum AttendanceStatus {
  present
  absent
  leave
  compensation_leave
}

model Intern {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique
  phone           String?
  department      String?
  startDate       DateTime     @map("start_date")
  endDate         DateTime?    @map("end_date")
  status          InternStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  attendances     Attendance[]
  saturdayRosters SaturdayRoster[]
  compensationLeaves CompensationLeave[]

  @@map("interns")
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  internId  String           @map("intern_id") @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus @default(present)
  remarks   String?
  createdAt DateTime         @default(now()) @map("created_at")

  intern    Intern           @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("attendances")
}

model SaturdayRoster {
  id        String   @id @default(uuid()) @db.Uuid
  internId  String   @map("intern_id") @db.Uuid
  date      DateTime @db.Date
  present   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("saturday_rosters")
}

model CompensationLeave {
  id          String    @id @default(uuid()) @db.Uuid
  internId    String    @map("intern_id") @db.Uuid
  earnedDate  DateTime  @map("earned_date") @db.Date
  usedDate    DateTime? @map("used_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  intern      Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("compensation_leaves")
}
