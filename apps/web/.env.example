# ── Web app environment ───────────────────────────────────────────────
# Copy this file to .env.local and fill in real values (Next.js loads .env.local).

# Public base URL of the web app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3535

# Base URL of the NestJS API. Dev default: :5005.
NEXT_PUBLIC_API_URL=http://localhost:5005

# Base URL of the AI service (RAG UI).
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (type "Web application").
# MUST match GOOGLE_CLIENT_ID in apps/api/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google reCAPTCHA v2 checkbox — site key for the contact form.
# Get at https://www.google.com/recaptcha/admin#list (type: reCAPTCHA v2 → Checkbox).
# Must pair with RECAPTCHA_SECRET_KEY in apps/api/.env. Test site key that always passes:
#   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Leave empty locally to hide the widget (backend will skip verification when its secret is empty).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=