PORT=8000
ENVIRONMENT=development
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log output format: "json" (default, one JSON record per line — ship to
# CloudWatch/Loki/Datadog) or "pretty" (human-readable for local dev).
LOG_FORMAT=json
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Must match EMBEDDING_MODEL's output dimension and the Qdrant collection size.
EMBEDDING_DIM=768
# Hybrid retrieval (dense + BM25 fused with RRF). Set false for dense-only.
HYBRID_SEARCH=true
SPARSE_MODEL=Qdrant/bm25
QDRANT_URL=http://localhost:6333
# Leave empty if your Qdrant instance has no API key configured.
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Chunks embedded per batch; lower this on memory-constrained machines.
EMBEDDING_BATCH_SIZE=32
# Retrieval hits scoring below this cosine similarity are dropped from context.
# Note: E5 models compress scores into ~0.7-0.9, so this is not a typical 0-1 value.
RAG_SCORE_THRESHOLD=0.78

# --- Reranking -------------------------------------------------------------
# A cross-encoder reorders the retrieval shortlist before it becomes LLM
# context; it is markedly better than embedding similarity at picking the
# passage that actually answers the question. Multilingual, so it handles the
# English / Nepali / romanized-Nepali mix. Costs ~150-400ms on CPU per query;
# set RERANK_ENABLED=false to trade answer quality for that latency.
# NOTE: the default model is ~2.2GB and downloads from HuggingFace on first
# start (warmed during startup validation, not on a user's first question). If
# that is not acceptable, set RERANK_ENABLED=false — retrieval then falls back
# to fused RRF order and everything else works unchanged.
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BATCH_SIZE=16
# Shortlist size handed to the reranker. Higher recall is what makes reranking
# pay off, but cost is linear in this number.
RERANK_CANDIDATES=20

# --- Notice chatbot retrieval ----------------------------------------------
# Absolute floor for vector hits. Well below the old hard 0.75 gate, which
# discarded correct-but-loosely-phrased matches and produced "I couldn't find
# anything" for questions the corpus did answer.
NOTICE_SEARCH_MIN_SCORE=0.62
# Relative cutoff: drop hits scoring more than this far below the best hit, so
# the quality bar scales with how hard the query is.
NOTICE_SEARCH_RELATIVE_MARGIN=0.08

# LLM provider chain. Order is chosen per call, not fixed:
#   interactive chat/answers -> Groq -> Gemini -> OpenCode Zen (fastest first)
#   background notice analysis -> OpenCode Zen -> Groq -> Gemini (best first)
# Groq answers in ~1-2s; OpenCode Zen's DeepSeek is a reasoning model that
# routinely takes 30-100s, which is fine for scraping but not for a user
# watching a chat bubble. Each provider is optional and skipped if its key is
# empty; if none are set, an extractive fallback is used.
# OpenCode Zen: primary, generous free quota for DeepSeek. The OpenAI-
# compatible endpoint (used by DeepSeek/GLM/Kimi/MiniMax/Grok on this
# gateway) is https://opencode.ai/zen/v1/chat/completions — the Responses
# and Anthropic-compatible endpoints under opencode.ai/zen/v1 are for other
# model families and don't apply here.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
# Groq API key for LLM answers (second in the chain).
GROQ_API_KEY=
# Groq chat model used to generate answers.
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated Groq keys used for round-robin rotation (avoids 429 rate limits).
GROQ_API_KEYS=
# Gemini API key + model for document OCR/summarization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Fallback default for max concurrent LLM summarizations during a scrape run.
# The live value comes from the admin `scraping.summarizeConcurrency` setting
# (sent per-run by the API); this env var applies only when no explicit value
# is passed. Raise it if your Groq/Gemini plan allows higher throughput.
SUMMARIZE_CONCURRENCY=2
TESSERACT_LANG=nep+eng
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3535,http://localhost:5005
