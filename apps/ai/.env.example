PORT=8000
ENVIRONMENT=development
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log output format: "json" (default, one JSON record per line — ship to
# CloudWatch/Loki/Datadog) or "pretty" (human-readable for local dev).
LOG_FORMAT=json
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Must match EMBEDDING_MODEL's output dimension and the Qdrant collection size.
EMBEDDING_DIM=768
# Hybrid retrieval (dense + BM25 fused with RRF). Set false for dense-only.
HYBRID_SEARCH=true
SPARSE_MODEL=Qdrant/bm25
QDRANT_URL=http://localhost:6333
# Leave empty if your Qdrant instance has no API key configured.
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Chunks embedded per batch; lower this on memory-constrained machines.
EMBEDDING_BATCH_SIZE=32
# Retrieval hits scoring below this cosine similarity are dropped from context.
# Note: E5 models compress scores into ~0.7-0.9, so this is not a typical 0-1 value.
RAG_SCORE_THRESHOLD=0.78
# Groq API key for LLM answers. If empty, an extractive fallback is used.
GROQ_API_KEY=
# Groq chat model used to generate answers.
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated Groq keys used for round-robin rotation (avoids 429 rate limits).
GROQ_API_KEYS=
# Gemini API key + model for document OCR/summarization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Fallback default for max concurrent LLM summarizations during a scrape run.
# The live value comes from the admin `scraping.summarizeConcurrency` setting
# (sent per-run by the API); this env var applies only when no explicit value
# is passed. Raise it if your Groq/Gemini plan allows higher throughput.
SUMMARIZE_CONCURRENCY=2
TESSERACT_LANG=nep+eng
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3535,http://localhost:5005
